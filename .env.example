# Firebase / Firestore — produção e desenvolvimento
# As chaves de configuração do app Web não são segredos; não inclua credenciais administrativas.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Cloud Storage fica desativado nesta fase Spark.

# Etapa 1 / DP-004: atendimento econômico só no emulador isolado, sem login.
# Ative ao executar o emulador com firebase.development.json (npm run dev:finance).
VITE_FINANCE_FIRESTORE_EMULATOR=
