rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function optionalString(data, field) {
      return data.get(field, null) == null || data.get(field, null) is string;
    }

    function validTicketId(ticketId) {
      return ticketId is string && ticketId.matches('^GOP-AR-[0-9]{4}-[0-9]{4}$');
    }

    function validTicketShape(data, ticketId) {
      return data.keys().hasOnly([
          'id_chamado',
          'unidade_escolar',
          'designacao',
          'data_solicitacao',
          'local_demanda',
          'tipo_demanda',
          'tipo_aparelho',
          'btu_existente',
          'btu_pretendido',
          'status_atual',
          'setor_responsavel',
          'proxima_providencia',
          'ultima_movimentacao',
          'informacao_validada',
          'prioridade',
          'comunicacao_cto',
          'observacoes',
          'resultado_aptidao',
          'criado_em',
          'modificado_em'
        ])
        && data.keys().hasAll([
          'id_chamado',
          'unidade_escolar',
          'designacao',
          'data_solicitacao',
          'local_demanda',
          'tipo_demanda',
          'status_atual',
          'setor_responsavel',
          'prioridade',
          'criado_em',
          'modificado_em'
        ])
        && validTicketId(ticketId)
        && data.id_chamado == ticketId
        && data.unidade_escolar is string
        && data.designacao is string
        && data.data_solicitacao is string
        && data.local_demanda is string
        && data.tipo_demanda is string
        && data.status_atual is string
        && data.setor_responsavel is string
        && data.prioridade is string
        && data.criado_em is string
        && data.modificado_em is string
        && optionalString(data, 'tipo_aparelho')
        && optionalString(data, 'btu_existente')
        && optionalString(data, 'btu_pretendido')
        && optionalString(data, 'proxima_providencia')
        && optionalString(data, 'ultima_movimentacao')
        && optionalString(data, 'informacao_validada')
        && optionalString(data, 'comunicacao_cto')
        && optionalString(data, 'observacoes')
        && optionalString(data, 'resultado_aptidao');
    }

    function ticketSchoolExists(data) {
      return exists(/databases/$(database)/documents/escolas/$(data.designacao));
    }

    function validHistoryShape(data, eventId) {
      return data.keys().hasOnly([
          'id_evento',
          'data',
          'id_chamado',
          'designacao',
          'unidade_escolar',
          'marco_relevante',
          'setor',
          'responsavel_registro',
          'observacao'
        ])
        && data.keys().hasAll([
          'id_evento',
          'data',
          'marco_relevante',
          'setor',
          'responsavel_registro'
        ])
        && data.id_evento == eventId
        && data.id_evento is string
        && data.data is string
        && data.marco_relevante is string
        && data.setor is string
        && data.responsavel_registro is string
        && optionalString(data, 'id_chamado')
        && optionalString(data, 'designacao')
        && optionalString(data, 'unidade_escolar')
        && optionalString(data, 'observacao');
    }

    function historyTicketExistsAfter(data) {
      let ticketId = data.get('id_chamado', '');
      return ticketId == ''
        || existsAfter(/databases/$(database)/documents/chamados/$(ticketId));
    }

    function validCounterShape(data) {
      return data.keys().hasOnly(['ano', 'ultimoNumero', 'ultimoId', 'atualizado_em'])
        && data.keys().hasAll(['ano', 'ultimoNumero', 'ultimoId', 'atualizado_em'])
        && data.ano is string
        && data.ultimoNumero is int
        && validTicketId(data.ultimoId)
        && data.atualizado_em is string;
    }

    function counterMatchesTicketAfter(data) {
      return existsAfter(/databases/$(database)/documents/chamados/$(data.ultimoId))
        && getAfter(/databases/$(database)/documents/chamados/$(data.ultimoId)).data.id_chamado == data.ultimoId
        && getAfter(/databases/$(database)/documents/chamados/$(data.ultimoId)).data.criado_em == data.atualizado_em;
    }

    function validId(value) {
      // matches só é aplicável a strings; também recusa tipos incorretos.
      return value.matches('^[A-Za-z0-9_.:-]{1,128}$');
    }

    function text(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function validItem(item, itemId) {
      let quantity = item.quantity;
      let price = item.unitPriceUnits4;
      let total = item.lineTotalUnits4;
      let capacity = item.capacityBtu;
      let source = item.sourceRef;
      let coverageSource = item.coverageSourceRef;
      let coverage = item.coverage;
      let nature = item.referenceNature;
      let hasSource = source.matches('^[\\s\\S]*\\S[\\s\\S]*$');
      let calculated = quantity == null ? null
        : (coverage == 'incluido' && coverageSource.matches('^[\\s\\S]*\\S[\\s\\S]*$')) ? 0
        : price == null ? null : quantity * price;
      // Todos os campos permitidos são lidos abaixo: ausentes também recusam
      // a escrita. hasOnly impede extras sem repetir toda a lista em hasAll.
      return item.keys().hasOnly([
          'id', 'description', 'equipmentType', 'capacityBtu', 'equipmentRef',
          'quantity', 'coverage', 'coverageSourceRef', 'referenceNature', 'unitPriceUnits4',
          'sourceRef', 'referenceVersion', 'catalogId', 'categoryCode', 'lineTotalUnits4'
        ])
        && validId(item.id) && item.id == itemId
        && item.description.matches('^[\\s\\S]{0,500}$')
        && item.equipmentType.matches('^[\\s\\S]{0,120}$')
        && item.equipmentRef.matches('^[\\s\\S]{0,120}$')
        && (capacity == null || (capacity is int && capacity >= 1 && capacity <= 9007199254740991))
        && (quantity == null || (quantity is int && quantity >= 0 && quantity <= 1000000))
        && (price == null || (price is int && price >= 0 && price <= 10000000000
          && hasSource && nature != 'nao_informada'
          && (quantity == null || quantity * price <= 450000000000000)))
        // O cálculo abaixo já garante total >= 0 pelos operandos validados.
        && (total == null || (total is int && total <= 450000000000000))
        && coverage in ['a_confirmar', 'incluido', 'adicional']
        && nature in ['nao_informada', 'provisoria', 'informada', 'contratual_informada']
        && source.matches('^[\\s\\S]{0,300}$')
        && coverageSource.matches('^[\\s\\S]{0,300}$')
        && item.referenceVersion.matches('^[\\s\\S]{0,120}$')
        && item.catalogId.matches('^[\\s\\S]{0,120}$')
        && item.categoryCode.matches('^[\\s\\S]{0,120}$')
        && (nature != 'contratual_informada' || (
          hasSource && item.referenceVersion.matches('^[\\s\\S]*\\S[\\s\\S]*$')
          && item.catalogId.matches('^[\\s\\S]*\\S[\\s\\S]*$')
        ))
        && total == calculated;
    }

    function validItemsHead(data) {
      let items = data.items;
      let itemIds = data.itemIds;
      let count = items.size();
      // Teto técnico desta etapa: quatro grupos por atendimento. A validação
      // completa foi medida contra o limite de 1.000 expressões das Rules.
      return items is list && count >= 1 && count <= 4
        && itemIds is list && itemIds.size() == count
        && itemIds.toSet().size() == count
        && validItem(items[0], itemIds[0]);
    }

    function validItemsTail(data) {
      let items = data.items;
      let itemIds = data.itemIds;
      let count = items.size();
      // O main valida shape/IDs e o primeiro item; a revisão valida os demais.
      // A igualdade getAfter nos dois sentidos exige ambos atomicamente,
      // mantendo o schema inteiro validado sem duplicar expressões.
      return (count <= 1 || validItem(items[1], itemIds[1]))
        && (count <= 2 || validItem(items[2], itemIds[2]))
        && (count <= 3 || validItem(items[3], itemIds[3]));
    }

    function ticketSchool(ticketId, schoolId) {
      return validId(ticketId)
        && get(/databases/$(database)/documents/chamados/$(ticketId)).data.designacao == schoolId;
    }

    function validLinks(data) {
      let schoolId = data.schoolId;
      let ticketIds = data.ticketIds;
      let count = ticketIds.size();
      return validId(schoolId)
        && exists(/databases/$(database)/documents/escolas/$(schoolId))
        && ticketIds is list && count <= 8
        && ticketIds.toSet().size() == count
        && (count <= 0 || ticketSchool(ticketIds[0], schoolId))
        && (count <= 1 || ticketSchool(ticketIds[1], schoolId))
        && (count <= 2 || ticketSchool(ticketIds[2], schoolId))
        && (count <= 3 || ticketSchool(ticketIds[3], schoolId))
        && (count <= 4 || ticketSchool(ticketIds[4], schoolId))
        && (count <= 5 || ticketSchool(ticketIds[5], schoolId))
        && (count <= 6 || ticketSchool(ticketIds[6], schoolId))
        && (count <= 7 || ticketSchool(ticketIds[7], schoolId));
    }

    function validCivilDate(date) {
      let parts = date.split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
      let days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
      return day <= days[month - 1];
    }

    function validDate(data) {
      return data.plannedDate == '' || (
        data.plannedDate is string
        && data.plannedDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && data.plannedDate.matches(data.plannedMonth + '-[0-9]{2}')
        && validCivilDate(data.plannedDate)
      );
    }

    function validAttendance(data, attendanceId) {
      return data.keys().size() == 15
        && data.keys().hasOnly([
          'id', 'revision', 'createdAt', 'updatedAt', 'schoolId', 'plannedMonth',
          'plannedDate', 'serviceKind', 'cycle', 'visitId', 'ticketIds',
          'responsibleLabel', 'sessionId', 'items', 'itemIds'
        ])
        && validId(attendanceId) && data.id == attendanceId
        && data.revision is int && data.revision > 0 && data.revision <= 1000000
        && data.createdAt is timestamp && data.updatedAt == request.time
        && data.plannedMonth is string && data.plannedMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && !data.plannedMonth.matches('^0000-.*')
        && validDate(data)
        && data.serviceKind in ['preventiva', 'corretiva', 'outra']
        && text(data.cycle, 120)
        && (data.visitId == '' || validId(data.visitId))
        && text(data.responsibleLabel, 160)
        && validId(data.sessionId)
        && validLinks(data)
        && validItemsHead(data);
    }

    function revisionMatchesAfter(data, attendanceId) {
      return getAfter(/databases/$(database)/documents/atendimentos_economicos/$(attendanceId)/revisoes/$('v' + string(data.revision))).data == data;
    }

    match /escolas/{schoolId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /modelos_email/{templateId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /chamados/{ticketId} {
      allow read: if true;

      allow create: if validTicketShape(request.resource.data, ticketId)
        && ticketSchoolExists(request.resource.data);

      allow update: if validTicketShape(request.resource.data, ticketId)
        && request.resource.data.id_chamado == resource.data.id_chamado
        && request.resource.data.criado_em == resource.data.criado_em
        && request.resource.data.unidade_escolar == resource.data.unidade_escolar
        && request.resource.data.designacao == resource.data.designacao
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'local_demanda',
          'tipo_demanda',
          'tipo_aparelho',
          'btu_existente',
          'btu_pretendido',
          'status_atual',
          'setor_responsavel',
          'proxima_providencia',
          'ultima_movimentacao',
          'informacao_validada',
          'prioridade',
          'comunicacao_cto',
          'observacoes',
          'resultado_aptidao',
          'modificado_em'
        ]);

      allow delete: if false;
    }

    match /historico/{eventId} {
      allow read: if true;

      allow create: if validHistoryShape(request.resource.data, eventId)
        && historyTicketExistsAfter(request.resource.data);

      allow update: if validHistoryShape(request.resource.data, eventId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['observacao']);

      allow delete: if false;
    }

    match /contadores/{counterId} {
      allow read: if counterId.matches('^chamados-[0-9]{4}$');

      allow create: if counterId.matches('^chamados-[0-9]{4}$')
        && validCounterShape(request.resource.data)
        && request.resource.data.ultimoNumero == 1
        && counterMatchesTicketAfter(request.resource.data);

      allow update: if counterId.matches('^chamados-[0-9]{4}$')
        && validCounterShape(request.resource.data)
        && request.resource.data.ano == resource.data.ano
        && request.resource.data.ultimoNumero == resource.data.ultimoNumero + 1
        && request.resource.data.ultimoId != resource.data.ultimoId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ultimoNumero',
          'ultimoId',
          'atualizado_em'
        ])
        && counterMatchesTicketAfter(request.resource.data);

      allow delete: if false;
    }

    match /atendimentos_economicos/{attendanceId} {
      allow read: if true;
      allow create, update: if validAttendance(request.resource.data, attendanceId)
        && (request.method == 'create'
          ? (request.resource.data.revision == 1 && request.resource.data.createdAt == request.time)
          : (request.resource.data.id == resource.data.id
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.revision == resource.data.revision + 1))
        && revisionMatchesAfter(request.resource.data, attendanceId);
      allow delete: if false;

      match /revisoes/{revisionId} {
        allow read: if true;
        allow create: if revisionId == 'v' + string(request.resource.data.revision)
          && request.resource.data.updatedAt == request.time
          && validItemsTail(request.resource.data)
          && getAfter(/databases/$(database)/documents/atendimentos_economicos/$(attendanceId)).data == request.resource.data;
        allow update, delete: if false;
      }
    }


    function validVisitDate(value, month) {
      return value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && value.matches(month + '-[0-9]{2}')
        && validCivilDate(value);
    }

    function validVisitPlanning(data, visitId) {
      return data.keys().size() == 16
        && data.keys().hasOnly([
          'id', 'schoolId', 'plannedDate', 'plannedMonth', 'kind', 'cycle',
          'equipmentCount', 'note', 'reportedDate', 'reportReference',
          'history', 'revision', 'sessionId', 'archived', 'createdAt', 'updatedAt'
        ])
        && validId(visitId) && data.id == visitId
        && data.schoolId is string && validId(data.schoolId)
        && exists(/databases/$(database)/documents/escolas/$(data.schoolId))
        && data.plannedMonth is string
        && data.plannedMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && !data.plannedMonth.matches('^0000-.*')
        && validVisitDate(data.plannedDate, data.plannedMonth)
        && data.kind in ['preventiva', 'corretiva', 'outra']
        && text(data.cycle, 80)
        && text(data.note, 500)
        && text(data.reportReference, 120)
        && (data.reportedDate == '' || (
          data.reportedDate is string
          && data.reportedDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && validCivilDate(data.reportedDate)
        ))
        && (data.equipmentCount == null || (
          data.equipmentCount is int && data.equipmentCount >= 0
          && data.equipmentCount <= 100000
        ))
        && data.history is list && data.history.size() <= 80
        && data.revision is int && data.revision > 0 && data.revision <= 1000000
        && data.archived is bool
        && data.createdAt is timestamp
        && data.updatedAt == request.time
        && data.sessionId is string && validId(data.sessionId);
    }

    function visitRevisionMatchesAfter(data, visitId) {
      return getAfter(/databases/$(database)/documents/programacao_visitas/$(visitId)/revisoes/$('v' + string(data.revision))).data == data;
    }

    match /programacao_visitas/{visitId} {
      allow read: if true;
      allow create, update: if validVisitPlanning(request.resource.data, visitId)
        && (request.method == 'create'
          ? (
            request.resource.data.revision == 1
            && request.resource.data.createdAt == request.time
            && request.resource.data.archived == false
          )
          : (
            resource.data.archived == false
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.history.size() >= resource.data.history.size()
          )
        )
        && visitRevisionMatchesAfter(request.resource.data, visitId);
      allow delete: if false;

      match /revisoes/{revisionId} {
        allow read: if true;
        allow create: if revisionId == 'v' + string(request.resource.data.revision)
          && validVisitPlanning(request.resource.data, visitId)
          && getAfter(/databases/$(database)/documents/programacao_visitas/$(visitId)).data == request.resource.data;
        allow update, delete: if false;
      }
    }


    // Ajustes de planejamento editáveis, sem modificar dados do cadastro operacional.
    function validPlanningAdjustment(data, schoolId) {
      return data.keys().size() == 11
        && data.keys().hasOnly([
          'id','schoolId','month','equipmentCount','budgetUnits4',
          'schoolLabel','archived','revision','sessionId','createdAt','updatedAt'
        ])
        && schoolId.matches('^[0-9]{6}$')
        && data.id == schoolId && data.schoolId == schoolId
        && data.month is int && data.month >= 1 && data.month <= 6
        && data.equipmentCount is int && data.equipmentCount >= 0 && data.equipmentCount <= 100000
        && (data.budgetUnits4 == null || (
          data.budgetUnits4 is int && data.budgetUnits4 >= 0 && data.budgetUnits4 <= 1000000000000
        ))
        && data.schoolLabel is string && data.schoolLabel.size() <= 160
        && data.archived is bool
        && data.revision is int && data.revision >= 1 && data.revision <= 1000000
        && validId(data.sessionId)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function planningRevisionAfter(data, schoolId) {
      return getAfter(/databases/$(database)/documents/ajustes_planejamento/$(schoolId)/revisoes/$('v' + string(data.revision))).data == data;
    }

    match /ajustes_planejamento/{schoolId} {
      allow read: if true;
      allow create, update: if validPlanningAdjustment(request.resource.data,schoolId)
        && (request.method == 'create'
          ? (request.resource.data.revision == 1 && request.resource.data.createdAt == request.time)
          : (request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.revision == resource.data.revision + 1))
        && planningRevisionAfter(request.resource.data,schoolId);
      allow delete: if false;
      match /revisoes/{revisionId} {
        allow read: if true;
        allow create: if revisionId == 'v' + string(request.resource.data.revision)
          && validPlanningAdjustment(request.resource.data,schoolId)
          && getAfter(/databases/$(database)/documents/ajustes_planejamento/$(schoolId)).data == request.resource.data;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
