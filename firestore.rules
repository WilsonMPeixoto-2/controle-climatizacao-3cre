rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function optionalString(data, field) {
      return data.get(field, null) == null || data.get(field, null) is string;
    }

    function validTicketId(ticketId) {
      return ticketId is string && ticketId.matches('^GOP-AR-[0-9]{4}-[0-9]{4}$');
    }

    function validTicketShape(data, ticketId) {
      return data.keys().hasOnly([
          'id_chamado',
          'unidade_escolar',
          'designacao',
          'data_solicitacao',
          'local_demanda',
          'tipo_demanda',
          'tipo_aparelho',
          'btu_existente',
          'btu_pretendido',
          'status_atual',
          'setor_responsavel',
          'proxima_providencia',
          'ultima_movimentacao',
          'informacao_validada',
          'prioridade',
          'comunicacao_cto',
          'observacoes',
          'resultado_aptidao',
          'criado_em',
          'modificado_em'
        ])
        && data.keys().hasAll([
          'id_chamado',
          'unidade_escolar',
          'data_solicitacao',
          'local_demanda',
          'tipo_demanda',
          'status_atual',
          'setor_responsavel',
          'prioridade',
          'criado_em',
          'modificado_em'
        ])
        && validTicketId(ticketId)
        && data.id_chamado == ticketId
        && data.unidade_escolar is string
        && data.data_solicitacao is string
        && data.local_demanda is string
        && data.tipo_demanda is string
        && data.status_atual is string
        && data.setor_responsavel is string
        && data.prioridade is string
        && data.criado_em is string
        && data.modificado_em is string
        && optionalString(data, 'designacao')
        && optionalString(data, 'tipo_aparelho')
        && optionalString(data, 'btu_existente')
        && optionalString(data, 'btu_pretendido')
        && optionalString(data, 'proxima_providencia')
        && optionalString(data, 'ultima_movimentacao')
        && optionalString(data, 'informacao_validada')
        && optionalString(data, 'comunicacao_cto')
        && optionalString(data, 'observacoes')
        && optionalString(data, 'resultado_aptidao');
    }

    function validHistoryShape(data, eventId) {
      return data.keys().hasOnly([
          'id_evento',
          'data',
          'id_chamado',
          'designacao',
          'unidade_escolar',
          'marco_relevante',
          'setor',
          'responsavel_registro',
          'observacao'
        ])
        && data.keys().hasAll([
          'id_evento',
          'data',
          'marco_relevante',
          'setor',
          'responsavel_registro'
        ])
        && data.id_evento == eventId
        && data.id_evento is string
        && data.data is string
        && data.marco_relevante is string
        && data.setor is string
        && data.responsavel_registro is string
        && optionalString(data, 'id_chamado')
        && optionalString(data, 'designacao')
        && optionalString(data, 'unidade_escolar')
        && optionalString(data, 'observacao');
    }

    function historyTicketExistsAfter(data) {
      let ticketId = data.get('id_chamado', '');
      return ticketId == ''
        || existsAfter(/databases/$(database)/documents/chamados/$(ticketId));
    }

    match /escolas/{schoolId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /modelos_email/{templateId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /chamados/{ticketId} {
      allow read: if true;

      allow create: if validTicketShape(request.resource.data, ticketId)
        && request.resource.data.designacao is string;

      allow update: if validTicketShape(request.resource.data, ticketId)
        && request.resource.data.id_chamado == resource.data.id_chamado
        && request.resource.data.criado_em == resource.data.criado_em
        && request.resource.data.unidade_escolar == resource.data.unidade_escolar
        && request.resource.data.get('designacao', null) == resource.data.get('designacao', null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'local_demanda',
          'tipo_demanda',
          'tipo_aparelho',
          'btu_existente',
          'btu_pretendido',
          'status_atual',
          'setor_responsavel',
          'proxima_providencia',
          'ultima_movimentacao',
          'informacao_validada',
          'prioridade',
          'comunicacao_cto',
          'observacoes',
          'resultado_aptidao',
          'modificado_em'
        ]);

      allow delete: if false;
    }

    match /historico/{eventId} {
      allow read: if true;

      allow create: if validHistoryShape(request.resource.data, eventId)
        && historyTicketExistsAfter(request.resource.data);

      allow update: if validHistoryShape(request.resource.data, eventId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['observacao']);

      allow delete: if false;
    }

    match /contadores/{counterId} {
      allow read: if counterId.matches('^chamados-[0-9]{4}$');

      allow create: if counterId.matches('^chamados-[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['ano', 'ultimoNumero', 'atualizado_em'])
        && request.resource.data.keys().hasAll(['ano', 'ultimoNumero', 'atualizado_em'])
        && request.resource.data.ano is string
        && request.resource.data.ultimoNumero is int
        && request.resource.data.ultimoNumero == 1
        && request.resource.data.atualizado_em is string;

      allow update: if counterId.matches('^chamados-[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['ano', 'ultimoNumero', 'atualizado_em'])
        && request.resource.data.ano == resource.data.ano
        && request.resource.data.ultimoNumero is int
        && request.resource.data.ultimoNumero == resource.data.ultimoNumero + 1
        && request.resource.data.atualizado_em is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoNumero', 'atualizado_em']);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
